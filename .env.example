# ASP operator base URL (mutinynet = alpha, test funds only)
VITE_ARK_OPERATOR=https://mutinynet.arkade.sh

# Arkade network: bitcoin | testnet | signet | mutinynet | regtest
VITE_NETWORK=mutinynet

# Arbiter npub (known in advance by every peer; baked into the escrow script).
# Must be identical on both ends. Falls back to a built-in placeholder.
VITE_ARBITER=npub1wr9hjdry05jnu7alfym5yv5ygpnkae0a7hxpv496vw8v4mrgddwsa6rq70

# Comma-separated Nostr relays (used in later phases)
VITE_RELAYS=wss://relay.damus.io,wss://nos.lol

# Coordinator npub publishing the solver registry (kind 38389, d = "solvers").
# Falls back to the arbiter above when unset.
VITE_COORDINATOR=npub1wr9hjdry05jnu7alfym5yv5ygpnkae0a7hxpv496vw8v4mrgddwsa6rq70
